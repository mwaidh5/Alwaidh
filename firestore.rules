rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function settingsData() {
      return get(/databases/$(database)/documents/settings/site).data;
    }
    function emailVerified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    // The hardcoded owner never depends on the settings doc existing.
    function isOwner() {
      return emailVerified() && request.auth.token.email == 'mwaidh5@gmail.com';
    }
    function isAdmin() {
      return isOwner()
        || (emailVerified()
            && request.auth.token.email in settingsData().get('extraAdminEmails', []));
    }
    function isComputerStaff() {
      return emailVerified()
        && request.auth.token.email in settingsData().get('computerStaffEmails', []);
    }
    function isSolarStaff() {
      return emailVerified()
        && request.auth.token.email in settingsData().get('solarStaffEmails', []);
    }
    // Shop manager: the whole product catalogue, but nothing solar-side.
    function isShopManager() {
      return emailVerified()
        && request.auth.token.email in settingsData().get('shopManagerEmails', []);
    }
    // Field installer: sees nothing except the jobs assigned to them.
    function isInstaller() {
      return emailVerified()
        && request.auth.token.email in settingsData().get('installerEmails', []);
    }
    // Anyone who works here — used for the shared file library.
    function isStaff() {
      return isAdmin() || isComputerStaff() || isSolarStaff()
        || isShopManager() || isInstaller();
    }
    // The CRM: who may open which contacts book, assigned per person
    // from the Users page. Admins hold both books.
    function canCrm(section) {
      return isAdmin()
        || (section == 'solar' && emailVerified()
            && request.auth.token.email in settingsData().get('crmSolarEmails', []))
        || (section == 'computers' && emailVerified()
            && request.auth.token.email in settingsData().get('crmComputerEmails', []));
    }

    // CRM leads. Reads must be filtered by section, so the rule can prove
    // every returned doc is inside a book this person was given. Only an
    // admin may move a lead between books.
    // Facebook ad leads: the landing page writes here (create-only,
    // tight shape), and a Cloud Function copies each one into the CRM.
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'campaign', 'section'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() < 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() < 25
        && request.resource.data.campaign is string
        && request.resource.data.campaign.size() < 60
        && request.resource.data.get('city', '') is string
        && request.resource.data.section in ['solar', 'computers'];
      allow read, update, delete: if isAdmin();
    }

    match /crmContacts/{id} {
      allow read: if canCrm(resource.data.section);
      // Erasing a lead is the admin's alone — staff work the book,
      // they don't take pages out of it.
      allow delete: if isAdmin();
      allow create: if canCrm(request.resource.data.section);
      allow update: if canCrm(resource.data.section)
        && (isAdmin() || request.resource.data.section == resource.data.section);
    }

    // Product catalogue: public read. Admins and shop managers write anything;
    // computer staff may write computer/camera products; solar staff may write
    // solar products.
    match /products/{id} {
      allow read: if true;
      allow create: if isAdmin() || isShopManager()
        || (isComputerStaff() && request.resource.data.category in ['computers', 'tiandy-cameras'])
        || (isSolarStaff() && request.resource.data.category == 'solar');
      allow update: if isAdmin() || isShopManager()
        || (isComputerStaff()
            && resource.data.category in ['computers', 'tiandy-cameras']
            && request.resource.data.category in ['computers', 'tiandy-cameras'])
        || (isSolarStaff()
            && resource.data.category == 'solar'
            && request.resource.data.category == 'solar');
      allow delete: if isAdmin() || isShopManager()
        || (isComputerStaff() && resource.data.category in ['computers', 'tiandy-cameras'])
        || (isSolarStaff() && resource.data.category == 'solar');
    }

    // Shared file library: catalogues and other PDFs everyone who works here
    // can reach. Any staff member can add one; entries are never rewritten,
    // and only an admin or whoever uploaded it can remove one.
    match /library/{id} {
      allow read: if isStaff();
      allow create: if isStaff() && request.resource.data.by == request.auth.token.email;
      allow update: if false;
      // Removing a file is the admin's call: everyone else works from what
      // is on the shelf, so nobody can take one away from under them.
      allow delete: if isAdmin();
    }

    // Orders: guests can place orders; admins manage them; signed-in
    // customers can read their own orders.
    match /orders/{id} {
      // Guests order freely, but an order may only carry a signed-in
      // user's own uid — nobody can plant orders in another account's
      // history.
      allow create: if !('userUid' in request.resource.data)
        || request.resource.data.userUid == null
        || (request.auth != null && request.auth.uid == request.resource.data.userUid);
      allow read, update, delete: if isAdmin();
      allow read: if request.auth != null && request.auth.uid == resource.data.userUid;
      // The tracking page: knowing the order's unguessable id IS the
      // ticket, exactly like a courier tracking number. Single reads
      // only — listing stays with the admin.
      allow get: if true;
    }

    // User profiles: each user reads/writes their own doc; admins see everyone.
    match /users/{uid} {
      allow read, write: if isAdmin();
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Contact form submissions: anyone can submit; admins manage.
    match /contactSubmissions/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // Site settings (incl. role assignments) — public read so the app can
    // resolve roles before sign-in; admin write only.
    // What each staff device is looking at, so notifications can skip
    // the person already reading. One's own records only.
    match /presence/{id} {
      allow read: if isStaff() && resource.data.email == request.auth.token.email;
      allow create, update: if isStaff()
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(['email', 'key', 'at']);
      allow delete: if isStaff() && resource.data.email == request.auth.token.email;
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Back-in-stock waiting list: anyone may leave an email against a
    // product, nobody but the office (and the mailer function) reads the
    // list back. The doc id is product+email, so re-asking overwrites the
    // same entry instead of stacking copies.
    match /stockAlerts/{id} {
      allow create, update: if request.resource.data.keys().hasAll(['productId', 'email', 'notified'])
        && request.resource.data.email is string
        && request.resource.data.email.size() < 200
        && request.resource.data.email.matches('.*@.*')
        && request.resource.data.productId is string
        && request.resource.data.productId.size() < 100
        && request.resource.data.notified == false;
      allow read, delete: if isAdmin();
    }

    // Analytics page-view events: any visitor can record a view; admins read.
    match /analytics_events/{id} {
      allow create: if true;
      allow read: if isAdmin();
    }

    // Blog articles: the world reads what's published; staff see and
    // write everything, drafts included.
    match /blogPosts/{id} {
      allow get, list: if resource.data.published == true
        || isAdmin() || isComputerStaff() || isSolarStaff() || isShopManager();
      allow write: if isAdmin() || isComputerStaff() || isSolarStaff() || isShopManager();
    }

    // Solar system price list: public read; admins and solar staff write.
    match /solarPrices/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSolarStaff();
    }

    // The Central Bank initiative installment systems — same keepers.
    match /solarInstallments/{id} {
      allow read: if true;
      allow write: if isAdmin() || isSolarStaff();
    }

    // Live chat with site visitors. A conversation's id is a random UUID
    // minted in the visitor's browser — knowing it is what grants access,
    // like an order confirmation link — so single-document reads and writes
    // are open, but only staff can LIST the conversations.
    match /chats/{chatId} {
      allow get, create, update: if true;
      allow list: if isAdmin() || isComputerStaff() || isSolarStaff() || isShopManager();
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow get, list: if true;
        // Anyone may write into a conversation they know the id of, but
        // only real staff can sign a message as staff — a visitor cannot
        // forge a reply that looks like it came from the shop.
        allow create: if request.resource.data.get('from', 'guest') != 'staff'
          || isAdmin() || isComputerStaff() || isSolarStaff() || isShopManager();
        // A staff member may fix or withdraw their own reply for five
        // minutes; after that the record stands.
        allow update: if (isAdmin() || isComputerStaff() || isSolarStaff() || isShopManager())
          && resource.data.from == 'staff'
          && resource.data.by == request.auth.token.email
          && request.time < resource.data.at + duration.value(5, 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']);
        allow delete: if isAdmin()
          || ((isComputerStaff() || isSolarStaff() || isShopManager())
              && resource.data.from == 'staff'
              && resource.data.by == request.auth.token.email
              && request.time < resource.data.at + duration.value(5, 'm'));
      }
    }

    // Internal staff messaging: one-to-one chats and groups. Membership is
    // the access model — you only ever see a conversation your email is a
    // member of, so the app's query filters on it.
    match /teamChats/{chatId} {
      function member() {
        return emailVerified() && request.auth.token.email in resource.data.members;
      }
      allow read: if member();
      allow create: if emailVerified()
        && request.auth.token.email in request.resource.data.members;
      // Members keep the conversation up to date (last message, read marks,
      // adding people). Membership only ever grows — nobody can kick
      // anyone, themselves included — and the creator stays the creator.
      allow update: if member()
        && request.auth.token.email in request.resource.data.members
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.get('createdBy', '') == resource.data.get('createdBy', '');
      allow delete: if isAdmin() || (member() && resource.data.createdBy == request.auth.token.email);

      match /messages/{msgId} {
        function inChat() {
          return emailVerified()
            && request.auth.token.email in
               get(/databases/$(database)/documents/teamChats/$(chatId)).data.members;
        }
        allow read: if inChat();
        allow create: if inChat() && request.resource.data.by == request.auth.token.email;
        // A message never changes — except reactions (each member only
        // their own slot), and the author fixing their words for five
        // minutes after sending.
        allow update: if inChat()
          && ((request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
               && request.resource.data.get('reactions', {})
                    .diff(resource.data.get('reactions', {}))
                    .affectedKeys().hasOnly([request.auth.token.email]))
              || (resource.data.by == request.auth.token.email
                  && request.time < resource.data.at + duration.value(5, 'm')
                  && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt'])));
        allow delete: if isAdmin()
          || (inChat()
              && resource.data.by == request.auth.token.email
              && request.time < resource.data.at + duration.value(5, 'm'));
      }
    }

    // Solar install/repair jobs: admins and solar staff only.
    match /jobs/{id} {
      allow read, create, update: if isAdmin() || isSolarStaff();
      // Deleting for good is the admin's alone. Solar staff still move a
      // job to the Trash — that writes a deletedAt field, which is an
      // update — so nothing they do every day is affected, and a job can
      // always be brought back.
      allow delete: if isAdmin();
      // An installer may read only the jobs assigned to them. Firestore
      // applies this per document, so their query must carry the matching
      // installerEmails filter (see subscribeJobs). A job can have several
      // installers on it.
      allow read: if isInstaller()
        && request.auth.token.email in resource.data.installerEmails;
      // They can also work the job: edit its details and move it between
      // columns. They must stay on it — so they can neither hand it to
      // someone else nor take one that isn't theirs — and deleting stays
      // with the office (no 'deletedAt' may appear).
      allow update: if isInstaller()
        && request.auth.token.email in resource.data.installerEmails
        && request.auth.token.email in request.resource.data.installerEmails
        && !('deletedAt' in request.resource.data);
      // An installer can log a job themselves — a call-out they were sent
      // to directly — as long as they put themselves on it, so it can't be
      // used to create work for someone else.
      allow create: if isInstaller()
        && request.auth.token.email in request.resource.data.installerEmails;

      // History and comments for a job. Entries are a record of what
      // happened, so they can be added and read but never rewritten;
      // an admin can still delete one. Installers can follow and comment on
      // their own job.
      function ownJob() {
        return isInstaller()
          && request.auth.token.email in
             get(/databases/$(database)/documents/jobs/$(id)).data.get('installerEmails', []);
      }
      match /activity/{entryId} {
        allow read: if isAdmin() || isSolarStaff() || ownJob();
        allow create: if (isAdmin() || isSolarStaff() || ownJob())
                      && request.resource.data.by == request.auth.token.email;
        // History is written once — only reactions may be added, and each
        // person may touch only their own slot in the map.
        allow update: if (isAdmin() || isSolarStaff() || ownJob())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.get('reactions', {})
               .diff(resource.data.get('reactions', {}))
               .affectedKeys().hasOnly([request.auth.token.email]);
        allow delete: if isAdmin();
      }
    }
  }
}
