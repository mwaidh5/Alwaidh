<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. "production" is correct for TestFlight and the
	     App Store; Xcode maps it to the sandbox automatically for debug builds. -->
	<key>aps-environment</key>
	<string>production</string>
	<!-- Sign in with Apple. App Review require it beside Google (4.8), and
	     the capability must also be switched on for the App ID in the
	     Apple Developer portal. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
